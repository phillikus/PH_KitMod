IF
    Kit(Player1, PH_Phantom)
    Global("PH_INVISIBLE_1", "GLOBAL", 0)
    OR(2)
        StateCheck(Player1, STATE_INVISIBLE)
        StateCheck(Player1, STATE_IMPROVEDINVISIBILITY)
THEN
    RESPONSE #100
        SetGlobal("PH_INVISIBLE_1", "GLOBAL", 1)
        ApplySpellRES("phstrk", Player1)
END

IF
    Kit(Player1, PH_Phantom)
    Global("PH_INVISIBLE_1", "GLOBAL", 1)
    !StateCheck(Player1, STATE_INVISIBLE)
    !StateCheck(Player1, STATE_IMPROVEDINVISIBILITY)
THEN
    RESPONSE #100
        SetGlobal("PH_INVISIBLE_1", "GLOBAL", 0)
        ApplySpellRES("phshow", Player1)
END

IF
    !Kit(Player1, PH_Phantom)
    Global("PH_INVISIBLE_1", "GLOBAL", 1)
THEN
    RESPONSE #100
        SetGlobal("PH_INVISIBLE_1", "GLOBAL", 0)
END

