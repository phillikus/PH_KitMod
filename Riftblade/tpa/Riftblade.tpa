COPY ~PH_KITMOD\Riftblade\spl\rbrift.2da~ ~override~
COPY ~PH_KITMOD\Riftblade\spl\rbstep.spl~ ~override~
SAY NAME1 @1106
SAY UNIDENTIFIED_DESC @1107

