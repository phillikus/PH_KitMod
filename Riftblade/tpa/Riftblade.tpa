LAF rb_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(@1114) STR_VAR bam_file = rbfielc RET rbfield_icon = icon END
LAF rb_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(@1112) STR_VAR bam_file = rbstrkc RET rbstrk_icon = icon END
