IF
    Global("ST_SCRIPT_INIT", "GLOBAL", 0)
THEN
    RESPONSE #100
        SetGlobal("ST_SCRIPT_INIT", "GLOBAL", 1)
        SetGlobal("ST_COMBAT_SEEN", "GLOBAL", 0)
        SetGlobal("ST_OUT_OF_COMBAT", "GLOBAL", 0)
        SetGlobal("ST_COMBAT_EXHAUSTION_STAGE", "GLOBAL", 0)
END

IF
    !CombatCounter(0)
    Global("ST_COMBAT_SEEN", "GLOBAL", 0)
THEN
    RESPONSE #100
        SetGlobal("ST_COMBAT_SEEN", "GLOBAL", 1)
        SetGlobal("ST_OUT_OF_COMBAT", "GLOBAL", 0)
        SetGlobal("ST_COMBAT_EXHAUSTION_STAGE", "GLOBAL", 0)
        SetGlobalTimer("ST_COMBAT_EXHAUSTION_TIMER", "GLOBAL", 30)
END

IF
    CombatCounter(0)
    Global("ST_COMBAT_SEEN", "GLOBAL", 1)
THEN
    RESPONSE #100
        SetGlobal("ST_COMBAT_SEEN", "GLOBAL", 0)
        SetGlobal("ST_OUT_OF_COMBAT", "GLOBAL", 1)
        SetGlobalTimer("ST_OUT_OF_COMBAT_TIMER", "GLOBAL", 18)
END

IF
    !CombatCounter(0)
    Global("ST_COMBAT_SEEN", "GLOBAL", 1)
    Global("ST_COMBAT_EXHAUSTION_STAGE", "GLOBAL", 0)
    GlobalTimerExpired("ST_COMBAT_EXHAUSTION_TIMER", "GLOBAL")
    Kit(Player1, PH_Shocktrooper)
THEN
    RESPONSE #100
        SetGlobal("ST_COMBAT_EXHAUSTION_STAGE", "GLOBAL", 1)
        SetGlobalTimer("ST_COMBAT_EXHAUSTION_TIMER", "GLOBAL", 30)
        ApplySpellRES("stcmbex", Player1)
END

