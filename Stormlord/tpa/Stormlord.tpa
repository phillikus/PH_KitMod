COPY_EXISTING ~SPWI115.SPL~ ~OVERRIDE/slwi115.SPL~
WRITE_SHORT 0X1C 2

COPY_EXISTING ~SPWI308.SPL~ ~OVERRIDE/slwi308.SPL~
WRITE_SHORT 0X1C 2

COPY_EXISTING ~SPWI615.SPL~ ~OVERRIDE/slwi615.SPL~
WRITE_SHORT 0X1C 2